<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests of the core (no UI): the library (folders, connections, credentials) with every check, the vault, import/export, the engine
    targets, the sync with ThixCloud against an in-memory cloud (two computers), Matgate accounts, setup, autostart and updates.
    The UI is tested in ThixGate.UiTests.
  -->
  <PropertyGroup>
    <TargetFramework>$(DesktopTargetFramework)</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <SupportedOSPlatformVersion Condition="'$(OS)' == 'Windows_NT'">10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="GitHubActionsTestLogger" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ThixGate.Core\ThixGate.Core.csproj" />
  </ItemGroup>

</Project>
