<mat:MatWindow xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:mat="using:MatDesktop"
               xmlns:controls="using:ThixGate.Controls"
               x:Class="ThixGate.MainWindow"
               Title="ThixGate" Width="1280" Height="820" MinWidth="900" MinHeight="560"
               WindowStartupLocation="CenterScreen">
  <!--
    The one window of ThixGate in MatDesktop's chrome: the title bar (DESK-03: logo and word mark, the open sessions in the middle, the
    caption buttons on Windows, the traffic lights on macOS), the menu (LibraryNav: the library as a tree with "Alle Verbindungen", below a line
    Zugangsdaten, Matgate, Einstellungen, at its foot the cloud state, the version = About and the fold to a rail) and the page.
  -->
  <Grid RowDefinitions="Auto,*">
    <mat:MatTitleBar x:Name="TitleBar" AppName="ThixGate">
      <mat:MatTitleBar.WordMark>
        <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource Mat.FontSizeXl}" FontWeight="SemiBold">
          <Run Text="Thix" /><Run Text="Gate" Foreground="{DynamicResource Mat.AccentText}" />
        </TextBlock>
      </mat:MatTitleBar.WordMark>
      <mat:MatTitleBar.Center>
        <!-- The open sessions: always in sight (a click brings the first one to the front) -->
        <Button x:Name="SessionStatus" Theme="{StaticResource MatButton.Ghost}" IsVisible="False" HorizontalAlignment="Center"
                AutomationProperties.Name="Offene Sitzungen">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <mat:MatIcon Icon="monitor" Size="16" VerticalAlignment="Center" />
            <TextBlock x:Name="SessionText" VerticalAlignment="Center" MaxWidth="460" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Mat.Text}" />
          </StackPanel>
        </Button>
      </mat:MatTitleBar.Center>
    </mat:MatTitleBar>

    <!-- The menu with the library as a tree (its width is dragged at the splitter at its edge and remembered; folded: the rail), the page -->
    <Grid Grid.Row="1" x:Name="BodyGrid" ColumnDefinitions="270,*">
      <controls:LibraryNav x:Name="Sidebar" AppName="ThixGate" />
      <GridSplitter Grid.Column="0" x:Name="TreeSplitter" Width="5" HorizontalAlignment="Right" Background="Transparent" ResizeDirection="Columns"
                    ResizeBehavior="CurrentAndNext" Cursor="SizeWestEast"
                    AutomationProperties.Name="Breite des Menüs" />
      <!-- Right of the menu: the tabs of the open sessions above (only while there are some; the first tab is the page) and the page or a session -->
      <DockPanel Grid.Column="1">
        <Border DockPanel.Dock="Top" x:Name="TabStrip" IsVisible="False" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource Mat.Border}" Background="{DynamicResource Mat.NavBg}">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Tabs" Orientation="Horizontal" Spacing="4" Margin="8,6,8,6" />
          </ScrollViewer>
        </Border>
        <Panel x:Name="Body">
          <ContentControl x:Name="PageHost" />
        </Panel>
      </DockPanel>
    </Grid>
  </Grid>
</mat:MatWindow>
