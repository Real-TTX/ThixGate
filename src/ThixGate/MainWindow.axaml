<mat:MatWindow xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:mat="using:MatDesktop"
               xmlns:controls="using:ThixGate.Controls"
               x:Class="ThixGate.MainWindow"
               Title="ThixGate" Width="1280" Height="820" MinWidth="900" MinHeight="560"
               WindowStartupLocation="CenterScreen">
  <!--
    The one window of ThixGate in MatDesktop's chrome: the title bar (DESK-03: logo and word mark, the open sessions in the middle, the
    caption buttons on Windows, the traffic lights on macOS), the menu (DESK-04: Verbindungen, Ordner, Zugangsdaten, Matgate,
    Einstellungen below a line, at its foot the cloud state, the version = About and the fold to a rail), the library as a tree and the page.
  -->
  <Grid RowDefinitions="Auto,*">
    <mat:MatTitleBar x:Name="TitleBar" AppName="ThixGate">
      <mat:MatTitleBar.WordMark>
        <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource Mat.FontSizeXl}" FontWeight="SemiBold">
          <Run Text="Thix" /><Run Text="Gate" Foreground="{DynamicResource Mat.AccentText}" />
        </TextBlock>
      </mat:MatTitleBar.WordMark>
      <mat:MatTitleBar.Center>
        <!-- The open sessions: always in sight (a click brings the first one to the front) -->
        <Button x:Name="SessionStatus" Theme="{StaticResource MatButton.Ghost}" IsVisible="False" HorizontalAlignment="Center"
                AutomationProperties.Name="Offene Sitzungen">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <mat:MatIcon Icon="monitor" Size="16" VerticalAlignment="Center" />
            <TextBlock x:Name="SessionText" VerticalAlignment="Center" MaxWidth="460" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Mat.Text}" />
          </StackPanel>
        </Button>
      </mat:MatTitleBar.Center>
    </mat:MatTitleBar>

    <!-- The menu, the tree column of the library (its width is dragged at the splitter and remembered; hidden: width 0), the page -->
    <Grid Grid.Row="1" x:Name="BodyGrid" ColumnDefinitions="Auto,270,*">
      <mat:MatNav x:Name="Sidebar" AppName="ThixGate" />
      <controls:ConnectionTree Grid.Column="1" x:Name="Tree" />
      <GridSplitter Grid.Column="1" x:Name="TreeSplitter" Width="5" HorizontalAlignment="Right" Background="Transparent" ResizeDirection="Columns"
                    ResizeBehavior="CurrentAndNext" Cursor="SizeWestEast"
                    AutomationProperties.Name="Breite der Bibliothek" />
      <ContentControl Grid.Column="2" x:Name="PageHost" />
    </Grid>
  </Grid>
</mat:MatWindow>
